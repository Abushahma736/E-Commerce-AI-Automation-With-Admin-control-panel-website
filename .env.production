# Production Environment Variables
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-site.vercel.app

# Database (Use MongoDB Atlas for production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/esse-naturals

# Authentication
NEXTAUTH_URL=https://your-site.vercel.app
NEXTAUTH_SECRET=your-super-secure-secret-key-here

# Payment Gateway (Use test keys for demo)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_key_here

# AI Services (Optional for basic deployment)
GEMINI_API_KEY=your_gemini_api_key_optional
OPENAI_API_KEY=your_openai_api_key_optional

# Communication (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid_optional
TWILIO_AUTH_TOKEN=your_twilio_token_optional

# Demo Mode (Set to true for demo deployment)
DEMO_MODE=true
SKIP_OTP_GENERATION=true
