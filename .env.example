# MongoDB (Optional - falls back to JSON files)
MONGODB_URI=mongodb://localhost:27017/hack

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3005

# OTP Configuration
# Set to 'true' to bypass OTP generation and verification (for development/testing)
SKIP_OTP_GENERATION=false

# Twilio Configuration (for real SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# DeepSeek API Configuration
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
